{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "social-context-v2.schema.json",
  "title": "Market Attention social-context.v2",
  "type": "object",
  "required": ["schema_version", "status", "captured_at_utc", "research_only", "trade_authorization", "execution_allowed", "source_health", "items"],
  "properties": {
    "schema_version": {"const": "social-context.v2"},
    "status": {"type": "string"},
    "captured_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "previous_capture_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "research_only": {"const": true},
    "trade_authorization": {"const": false},
    "execution_allowed": {"const": false},
    "source_health": {"type": "object"},
    "items": {"type": "array", "items": {"type": "object", "required": ["coingecko_id", "name", "symbol", "mentions", "momentum"], "properties": {"coingecko_id": {"type": "string"}, "name": {"type": "string"}, "symbol": {"type": "string"}, "mentions": {"type": "object", "properties": {"google_news": {"$ref": "#/$defs/mentionSource"}, "reddit": {"$ref": "#/$defs/mentionSource"}}, "additionalProperties": true}, "momentum": {"type": "object", "properties": {"mention_change_by_source": {"type": "object"}}, "additionalProperties": true}}, "additionalProperties": true}},
    "identity_cache": {"type": "object"},
    "attribution": {"type": "string"}
  },
  "$defs": {
    "headline": {"type": "object", "required": ["title", "url", "published_at_utc"], "properties": {"title": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "published_at_utc": {"type": "string", "format": "date-time"}, "age_seconds": {"type": "integer", "minimum": 0}, "matched_text": {"enum": ["coin", "related", "title"]}}, "additionalProperties": true},
    "mentionSource": {"type": "object", "required": ["status", "coin_count_24h", "coin_count_7d", "related_count_24h", "related_count_7d", "listing_count_7d", "headlines", "related_headlines"], "properties": {"status": {"enum": ["FRESH", "DEGRADED", "UNAVAILABLE", "NOT_QUERIED"]}, "coin_count_24h": {"type": ["integer", "null"], "minimum": 0}, "coin_count_7d": {"type": ["integer", "null"], "minimum": 0}, "related_count_24h": {"type": ["integer", "null"], "minimum": 0}, "related_count_7d": {"type": ["integer", "null"], "minimum": 0}, "listing_count_7d": {"type": ["integer", "null"], "minimum": 0}, "newest_published_at_utc": {"type": ["string", "null"], "format": "date-time"}, "newest_age_seconds": {"type": ["integer", "null"], "minimum": 0}, "headlines": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/headline"}}, "related_headlines": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/headline"}}}, "additionalProperties": true}
  },
  "additionalProperties": true
}
